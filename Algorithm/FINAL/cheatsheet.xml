 <paragraph index="92" node_type="writer" parent_index="9">CONVEX HULL</paragraph>
 <paragraph index="93" node_type="writer" parent_index="9">#include &lt;iostream&gt;</paragraph>
 <paragraph index="94" node_type="writer" parent_index="9">#include &lt;vector&gt;</paragraph>
 <paragraph index="95" node_type="writer" parent_index="9">#include &lt;set&gt;</paragraph>
