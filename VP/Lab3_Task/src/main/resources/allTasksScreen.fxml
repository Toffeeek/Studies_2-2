<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="520.0" prefWidth="900.0" spacing="24.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.AllTasksController">
   <padding>
      <Insets bottom="45.0" left="90.0" right="90.0" top="45.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT">
         <children>
            <Button mnemonicParsing="false" onAction="#showAddTask" prefWidth="100.0" text="Back" />
         </children>
      </HBox>
      <TableView fx:id="taskTable" prefHeight="360.0" prefWidth="720.0" VBox.vgrow="ALWAYS">
         <columns>
            <TableColumn fx:id="nameColumn" prefWidth="150.0" text="Task Name" />
            <TableColumn fx:id="descColumn" prefWidth="300.0" text="Task Description" />
            <TableColumn fx:id="deadlineColumn" prefWidth="150.0" text="Deadline" />
            <TableColumn fx:id="actionColumn" prefWidth="120.0" text="Action" />
         </columns>
      </TableView>
   </children>
</VBox>
